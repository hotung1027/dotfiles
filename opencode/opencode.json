{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "docker-mcp": {
      "type": "local",
      "command": [
        "docker.exe",
        "mcp",
        "gateway",
        "run"
      ],
      "enabled": true,
    }
  },
  "permission": {
    "edit":"ask",
    "write":"ask",
    "read":"allow",
    "grep":"allow",
    "glob":"allow",
    "list":"allow",
    "lsp":"allow",
    "skill":"allow",
    "todowrite":"allow",
    "todoread":"allow",
    "bash":"ask",
    "webfetch":"allow",
    "websearch":"allow",
    "question":"allow",
    "docker-mcp":"allow",
  },
  "plugin": ["opencode-agent-skills"]
}
